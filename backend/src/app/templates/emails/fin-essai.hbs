{{#> layouts/main}}
<div style="max-width:600px;margin:0 auto;font-family:'Segoe UI',sans-serif;">
  <div style="background:#1e3a2f;padding:32px;text-align:center;border-radius:12px 12px 0 0;">
    <h1 style="color:#fff;margin:0;font-size:24px;font-weight:800;">Mentora</h1>
  </div>
  <div style="background:#fff;padding:40px 32px;border-radius:0 0 12px 12px;border:1px solid #e5e7eb;">
    <h2 style="color:#1e3a2f;font-size:20px;margin:0 0 16px;">Bonjour {{prenom}},</h2>
    <p style="color:#6b7280;margin:0 0 24px;line-height:1.6;">
      Votre période d'essai pour <strong style="color:#1e3a2f;">{{nomEcole}}</strong> expire dans
      <strong style="color:#dc2626;">{{joursRestants}} jour(s)</strong>, le <strong>{{finEssai}}</strong>.
    </p>
    <div style="background:#fef3c7;border:1px solid #fcd34d;border-radius:12px;padding:24px;margin-bottom:24px;text-align:center;">
      <p style="color:#92400e;font-size:36px;font-weight:800;margin:0 0 4px;">⏰ {{joursRestants}} jour(s)</p>
      <p style="color:#92400e;font-size:13px;margin:0;">avant la fin de votre essai gratuit</p>
    </div>
    <p style="color:#6b7280;margin:0 0 8px;line-height:1.6;">Après cette date, votre compte passera en plan Gratuit :</p>
    <ul style="color:#6b7280;margin:0 0 24px;padding-left:20px;line-height:2.2;font-size:14px;">
      <li>Limité à 25 étudiants</li>
      <li>Limité à 5 professeurs</li>
      <li>100 sessions par mois</li>
    </ul>
    <div style="text-align:center;margin-bottom:32px;">
      <a href="{{abonnementUrl}}" style="background:#919e19;color:#fff;padding:14px 32px;border-radius:10px;text-decoration:none;font-weight:700;font-size:15px;display:inline-block;">
        Continuer avec Mentora →
      </a>
    </div>
  </div>
  <p style="color:#9ca3af;font-size:11px;text-align:center;margin-top:16px;">© {{year}} Mentora. Tous droits réservés.</p>
</div>
{{/> layouts/main}}
