<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <div style="background: #1e3a2f; padding: 30px; text-align: center;">
    <h1 style="color: white; margin: 0; font-size: 24px;">Mentora</h1>
  </div>

  <div style="padding: 40px 30px; background: #ffffff;">
    <h2 style="color: #1e3a2f; margin-top: 0;">Bonjour {{ prenom }} 👋</h2>

    <p style="color: #444; font-size: 16px; line-height: 1.6;">
      Vos notes pour la session <strong>{{ titreSession }}</strong> sont maintenant disponibles.
    </p>

    <div style="text-align: center; margin: 32px 0;">
      
        href="{{ notesUrl }}"
        style="background: #4a7c5e; color: white; padding: 14px 32px; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 16px;"
      >
        Voir mes notes
      </a>
    </div>
  </div>

  <div style="background: #f5f0e8; padding: 20px; text-align: center;">
    <p style="color: #9b9589; font-size: 12px; margin: 0;">
      © {{ year }} Mentora — <a href="{{ websiteUrl }}" style="color: #4a7c5e;">mentora.foulisa.com</a>
    </p>
  </div>
</div>