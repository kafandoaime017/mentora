# Copier ce fichier en backend/.env (local), backend/.env.development ou backend/.env.prod
# et remplir les valeurs. Ne jamais commiter de vraies valeurs.

NODE_ENV=development

# === Serveur ===
PORT=5000

# === Base de données MySQL ===
DB_HOST=mentora_db
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=mentora

# === JWT ===
JWT_SECRET=
JWT_EXPIRES_IN=7d

# === Email ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# === URLs ===
LOGO_URL=
WEBSITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === OpenRouter ===
OPENROUTER_API_KEY=

# === Stripe ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY=
STRIPE_STARTER_YEARLY=
STRIPE_PRO_MONTHLY=
STRIPE_PRO_YEARLY=

# === Monitoring (Glitchtip) ===
SENTRY_DSN=
GLITCHTIP_ENVIRONMENT=development

# === Divers ===
CORS_ORIGIN=http://localhost:3000

# Rate limiting general (toutes les routes /api)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Rate limiting strict (login, inscription, reset mdp - anti brute-force)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
